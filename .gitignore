/target
/.worktrees

# proptest failure-seed cache — regenerated on demand; not checked in (matches
# the repo's existing VS-1.1.2 proptest convention, which tracks no seeds).
proptest-regressions/

# VS-1.1.4 work-1.01 — ephemeral SQLite scratch DBs (WAL/SHM sidecars + the
# `just prepare` / CI `prepare-check` throwaway DBs). The `.sqlx/` offline query
# cache (1.03-populated) is COMMITTED, never ignored — only these scratch files are.
*.db
*.db-wal
*.db-shm
/pulse-prepare.db*
/ci-prepare.db*

# AI assistant config — keep the canonical repo "zero AI traces".
# The global excludes file no longer ignores these (dual-repo workflow: AI
# scaffolding is tracked in the paired AI workspace, never committed here).
.claude/
CLAUDE.md
AGENTS.md
.codex/
.mcp.json
# Agent working directories — process state, not product. The superpowers
# plugin writes its SDD ledger and review diffs here when a session runs in
# this repo; they belong to the private AI workspace (see PUBLIC_BOUNDARY.md).
# Found untracked-but-unignored at the Release 1 boundary audit and moved out;
# this line keeps them out.
.superpowers/

# Local dev/testing secrets + config — NEVER committed (this is a PUBLIC repo).
# Real GLM/Z.AI credentials live here (gitignored) + in the macOS Keychain
# (the production read path, NFR-5). Only `.env.example` (secret-free) is tracked.
.env
.env.*
!.env.example

# r1.s1.w1 (ADR-0020) — the desktop shell's build artifacts.
# `ui/dist` is Vite output (build.rs writes a placeholder into it when absent so a
# Rust-only `cargo test` still compiles — see build.rs::ensure_frontend_dist).
# `gen/` is Tauri's generated schema directory. `ui/src/bindings.ts` is deliberately
# NOT ignored: it is COMMITTED and AC-8 fails on any regeneration diff.
# `/ui/node_modules` (r1.s1.w6) is Vite/Vitest's dep-optimization CACHE only
# (`ui/node_modules/.vite`), created because `vite.config.ts`'s `root: "ui"`
# resolves the default `cacheDir` under `ui/` -- the real installed packages
# stay at the top-level `/node_modules` above.
/node_modules
/ui/node_modules
/ui/dist
/gen
