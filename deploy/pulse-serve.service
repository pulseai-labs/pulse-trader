# The always-on PulseTrader server (r3.s3.w4, D6 / ADR-0026) as a systemd USER
# unit. The tailnet address and port live HERE only — this unit is the one
# place 100.90.203.21:8420 is written down; the server must never listen on a
# wildcard.
#
# The environment sets no credential: the credential file is the operator's,
# resolved by `pulse serve` itself from the app-data/config dir (w3, R3). No
# token ever appears in this unit, in its logs, or in any recipe.
[Unit]
Description=PulseTrader always-on server (pulse serve)
Wants=network-online.target
After=network-online.target
# #342 bounded restarts: give up after 3 failed starts in 900 s and stay in the
# `failed` state, so `systemctl --user --failed` shows it. systemd's default
# (5 starts in 10 s) never trips here: RestartSec=10 spaces starts too far
# apart, and a slow failure (the full 120 s bind retry + RestartSec = 130 s per
# cycle) is slower still. 3 x 130 s = 390 s < 900 s, so the limit trips for the
# slow shape; a fast exit (about RestartSec per cycle) trips it sooner.
# Consequences: a tailnet outage longer than about 6.5 minutes at boot ends
# `failed`; so does a fast, non-retried bind failure such as a port conflict
# (AddrInUse exits at once), where an unbounded unit would have self-healed.
# The start limit also counts manual starts. The recovery runbook is in the
# justfile, in the comment above the `deploy` recipe.
# These keys belong in [Unit], not [Service].
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
ExecStart=%h/.local/share/pulse-serve/bin/pulse serve --bind 100.90.203.21:8420
# D6 boot-race contract (w1): the tailnet address may not be routable yet at
# boot, so pulse serve retries the bind internally; systemd restarts the unit
# on failure after 10 seconds, up to the start limit above.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
