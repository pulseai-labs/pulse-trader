# The PulseTrader prod watcher (r4.s2.w4, Q2): one `pulse watch` probe cycle.
# Started by pulse-watch.timer every 60 seconds. The topic file and the watcher
# key are the operator's (cutover, SPINE.md step 6): ~/.config/pulse-watch/topic
# (0600) and ~/.ssh/pulse_watch_ed25519. No credential is set in the environment:
# `pulse watch` holds no token, and nothing it sends or logs carries a token, a
# credential URL, the topic or session data.
#
# The binary is draco-desk's own: the one `just deploy` installs into
# ~/.local/share/pulse-qa/bin (the same one pulse-backup-pull.sh verifies with),
# NOT prod's ~/.local/share/pulse-serve/bin — that copy is frozen and has no
# `watch` subcommand (r4.s2 close-review F1).
[Unit]
Description=PulseTrader prod watcher (pulse watch)

[Service]
Type=oneshot
ExecStart=%h/.local/share/pulse-qa/bin/pulse watch --url http://100.103.30.74:8420 --ssh-host macmini --topic-file %h/.config/pulse-watch/topic --state-file %h/.local/state/pulse-watch/state
