{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseTrader",
  "version": "0.1.2",
  "identifier": "com.pulseai-labs.pulsetrader",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseTrader",
        "width": 1440,
        "height": 900,
        "resizable": false,
        "decorations": false,
        "center": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
